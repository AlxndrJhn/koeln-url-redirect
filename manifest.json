{
  "manifest_version": 3,
  "name": "Köln Ratsinfo Mirror",
  "version": "1.4.1",
  "description": "Ändert die langsamen Stadt Köln URLs zu einem schnelleren Mirror.",
  "browser_specific_settings": {
    "gecko": {
      "id": "koeln-url-redirect@localhost",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ]
      }
    }
  },
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "webNavigation",
    "webRequest",
    "tabs"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://ratsinfo.sessionnet.verwaltung.stadtkoeln.de/*",
    "https://ratsinformation.stadt-koeln.de/getfile.asp?id=*",
    "https://ratsinformation.alex-360.com/getfile.asp?id=*",
    "https://ratsinformation.stadt-koeln.de/vo0050.asp?*",
    "https://ratsinformation.alex-360.com/vo0050.asp?*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html",
    "default_title": "Köln Ratsinfo Mirror"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}