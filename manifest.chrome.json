{
  "manifest_version": 3,
  "name": "Köln Ratsinfo Redirect",
  "version": "1.5.0",
  "description": "Ändert die langsamen Stadt Köln SessionNet URLs zu den neuen ratsinformation URLs auf ratsinformation.alex-360.com .",
  "minimum_chrome_version": "116",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "webNavigation",
    "webRequest"
  ],
  "host_permissions": [
    "https://ratsinfo.sessionnet.verwaltung.stadtkoeln.de/*",
    "https://ratsinformation.stadt-koeln.de/getfile.asp?id=*",
    "https://ratsinformation.alex-360.com/getfile.asp?id=*",
    "https://ratsinformation.stadt-koeln.de/vo0050.asp?*",
    "https://ratsinformation.alex-360.com/vo0050.asp?*",
    "https://ratsinformation.stadt-koeln.de/to0050.asp?*",
    "https://ratsinformation.alex-360.com/to0050.asp?*",
    "https://ratsinformation.stadt-koeln.de/si0057.asp?*",
    "https://ratsinformation.alex-360.com/si0057.asp?*",
    "https://ratsinformation.stadt-koeln.de/si0040.asp*",
    "https://ratsinformation.alex-360.com/si0040.asp*",
    "https://ratsinformation.stadt-koeln.de/si0046.asp*",
    "https://ratsinformation.alex-360.com/si0046.asp*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html",
    "default_title": "Köln Ratsinfo Redirect"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
